# Copy to apps/web/.env.local for local development.

# Local Supabase (supabase start) or a hosted project.
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-me

# Server-only. Never expose to the browser. Not used by the Next.js app in Phase 4
# (user writes go through the anon key + RLS). Keep it for CLI / seed / admin later.
SUPABASE_SERVICE_ROLE_KEY=replace-me

# Set to true only after enabling the Google provider in the Supabase dashboard
# (or [auth.external.google] in config.toml).
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
